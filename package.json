{
  "name": "@cascateer/server",
  "version": "1.0.0",
  "scripts": {
    "build": "rollup -c",
    "start": "node build/main.js",
    "dev": "set NODE_ENV=development && tsx src/main.ts",
    "update": "npm cache clean --force && npx npm-check-updates -u --format time && npm i"
  },
  "main": "./build/main.js",
  "dependencies": {
    "@cascateer/lib": "^1.0.101",
    "connect-redis": "^10.0.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "redis": "^6.1.0"
  },
  "devDependencies": {
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/node": "^26.1.2",
    "rollup": "^4.62.3",
    "typescript": "^6.0.2"
  }
}
